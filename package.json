{
  "name": "tally",
  "private": true,
  "type": "module",
  "workspaces": ["packages/*", "web"],
  "engines": { "node": ">=20" },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lint": "tsc --noEmit -p web",
    "dev": "npm run dev --workspace web",
    "contracts:build": "./scripts/build.sh",
    "contracts:test": "cargo test"
  }
}
